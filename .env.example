# APP_URL: The public URL where the application is hosted (used for YooKassa return_url).
APP_URL="http://localhost:3000"

# MASTER_PASSWORD: Password for the workshop master panel (/master/login).
# Set a strong password in production.
MASTER_PASSWORD="change_me_master_password"

# SESSION_SECRET: Secret key for signing HttpOnly master session cookies.
SESSION_SECRET="change_me_random_64_char_secret"

# YOOKASSA_SHOP_ID & YOOKASSA_SECRET_KEY: Credentials from YooKassa merchant dashboard.
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""

# DATABASE_PATH: Path to SQLite database file.
DATABASE_PATH="./yasna.db"
